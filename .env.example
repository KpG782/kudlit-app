SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# GEMINI_API_KEY is intentionally NOT a client variable. It lives only in the
# `gemini-proxy` Supabase Edge Function — set it via
# `supabase secrets set GEMINI_API_KEY=...`. See
# supabase/functions/gemini-proxy/README.md.
#
# HUGGINGFACE_TOKEN is intentionally NOT a client variable anymore. A token
# bundled in the app is extractable from the APK/web build. Gated model
# downloads must use a server-minted signed URL (Edge Function) or a public
# bucket. Do not add it back here.
